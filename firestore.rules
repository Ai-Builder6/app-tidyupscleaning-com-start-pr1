rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default Deny - Pillar 1: No blanket access
    match /{document=**} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Hardened Global Helpers
    // ─────────────────────────────────────────────────────────────────────────
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped Admin check with fallback to trusted admin collection
    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'booking@tidyupscleaning.com' ||
        request.auth.token.email == 'cleaningserviceyeg@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Path Variable Hardening - ID Poisoning Guard
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Entity Schema Validators
    // ─────────────────────────────────────────────────────────────────────────
    function isValidClient(data) {
      return data.keys().hasAll(['id', 'name', 'phone']) &&
             data.keys().hasOnly(['id', 'name', 'company', 'email', 'phone', 'secondaryPhone', 'address', 'status', 'tags', 'notes', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
             (!('company' in data) || (data.company is string && data.company.size() <= 150)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('secondaryPhone' in data) || (data.secondaryPhone is string && data.secondaryPhone.size() <= 30)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
             (!('status' in data) || (data.status in ['Client', 'Good lead', 'Bad lead', 'Spam', 'Lead', 'Archived'])) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || data.tags[0] is string)));
    }

    function isValidScheduledVisit(data) {
      return data.keys().hasAll(['id', 'clientName', 'phone', 'address', 'vanId']) &&
             data.keys().hasOnly(['id', 'jobId', 'clientName', 'phone', 'secondaryPhone', 'address', 'scheduledTime', 'durationMinutes', 'cleanerName', 'vanId', 'hubId', 'status', 'serviceType', 'notes', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 150 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
             data.address is string && data.address.size() <= 300 &&
             data.vanId is string && data.vanId.size() <= 50 &&
             (!('secondaryPhone' in data) || (data.secondaryPhone is string && data.secondaryPhone.size() <= 30)) &&
             (!('jobId' in data) || (data.jobId is string && data.jobId.size() <= 128)) &&
             (!('scheduledTime' in data) || (data.scheduledTime is string && data.scheduledTime.size() <= 100)) &&
             (!('durationMinutes' in data) || (data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 1440)) &&
             (!('cleanerName' in data) || (data.cleanerName is string && data.cleanerName.size() <= 100)) &&
             (!('hubId' in data) || (data.hubId is string && data.hubId.size() <= 50)) &&
             (!('status' in data) || (data.status in ['Scheduled', 'In Progress', 'Completed', 'Cancelled', 'Late', 'En Route'])) &&
             (!('serviceType' in data) || (data.serviceType is string && data.serviceType.size() <= 100)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidUnscheduledJob(data) {
      return data.keys().hasAll(['id', 'clientName', 'phone', 'address']) &&
             data.keys().hasOnly(['id', 'clientName', 'phone', 'address', 'serviceType', 'priority', 'estimatedHours', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.clientName is string && data.clientName.size() <= 150 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.address is string && data.address.size() <= 300 &&
             (!('serviceType' in data) || (data.serviceType is string && data.serviceType.size() <= 100)) &&
             (!('priority' in data) || (data.priority in ['Low', 'Normal', 'High', 'Urgent'])) &&
             (!('estimatedHours' in data) || (data.estimatedHours is number && data.estimatedHours >= 0 && data.estimatedHours <= 100));
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['id', 'name', 'phone']) &&
             data.keys().hasOnly(['id', 'name', 'role', 'phone', 'email', 'assignedVan', 'hubId', 'color', 'status']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 30 &&
             (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('assignedVan' in data) || (data.assignedVan is string && data.assignedVan.size() <= 50)) &&
             (!('hubId' in data) || (data.hubId is string && data.hubId.size() <= 50)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 10));
    }

    function isValidVanOverride(data) {
      return data.keys().hasAll(['vanId']) &&
             data.keys().hasOnly(['vanId', 'customVanName', 'cleanerName', 'phone', 'hubId', 'customHubName', 'color', 'updatedAt']) &&
             data.vanId is string && isValidId(data.vanId) &&
             (!('customVanName' in data) || (data.customVanName is string && data.customVanName.size() <= 100)) &&
             (!('cleanerName' in data) || (data.cleanerName is string && data.cleanerName.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('hubId' in data) || (data.hubId is string && data.hubId.size() <= 50)) &&
             (!('customHubName' in data) || (data.customHubName is string && data.customHubName.size() <= 100)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 20));
    }

    function isValidQuote(data) {
      return data.keys().hasAll(['id', 'quoteNumber', 'clientName', 'totalAmount', 'status']) &&
             data.keys().hasOnly(['id', 'quoteNumber', 'clientName', 'totalAmount', 'status', 'issueDate', 'lineItems', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.quoteNumber is string && data.quoteNumber.size() <= 50 &&
             data.clientName is string && data.clientName.size() <= 150 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['Draft', 'Sent', 'Approved', 'Converted', 'Declined'];
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['id', 'invoiceNumber', 'clientName', 'totalAmount', 'status']) &&
             data.keys().hasOnly(['id', 'invoiceNumber', 'clientName', 'totalAmount', 'status', 'issueDate', 'dueDate', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.invoiceNumber is string && data.invoiceNumber.size() <= 50 &&
             data.clientName is string && data.clientName.size() <= 150 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['Draft', 'Awaiting Payment', 'Paid', 'Overdue', 'Bad Debt'];
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Collection Match Blocks
    // ─────────────────────────────────────────────────────────────────────────

    // Clients Collection
    match /clients/{clientId} {
      allow get: if isVerified() && isValidId(clientId);
      allow list: if isVerified();
      allow create: if isVerified() && isValidId(clientId) && isValidClient(incoming()) && incoming().id == clientId;
      allow update: if isVerified() && isValidId(clientId) && isValidClient(incoming()) && incoming().id == existing().id && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'company', 'email', 'phone', 'secondaryPhone', 'address', 'status', 'tags', 'notes', 'updatedAt'])
      );
      allow delete: if isAdmin() && isValidId(clientId);
    }

    // Scheduled Visits Collection
    match /scheduledVisits/{visitId} {
      allow get: if isVerified() && isValidId(visitId);
      allow list: if isVerified();
      allow create: if isVerified() && isValidId(visitId) && isValidScheduledVisit(incoming()) && incoming().id == visitId;
      allow update: if isVerified() && isValidId(visitId) && isValidScheduledVisit(incoming()) && incoming().id == existing().id && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['clientName', 'phone', 'secondaryPhone', 'address', 'scheduledTime', 'durationMinutes', 'cleanerName', 'vanId', 'hubId', 'status', 'serviceType', 'notes', 'updatedAt'])
      );
      allow delete: if isAdmin() && isValidId(visitId);
    }

    // Unscheduled Jobs Collection
    match /unscheduledJobs/{jobId} {
      allow get: if isVerified() && isValidId(jobId);
      allow list: if isVerified();
      allow create: if isVerified() && isValidId(jobId) && isValidUnscheduledJob(incoming()) && incoming().id == jobId;
      allow update: if isVerified() && isValidId(jobId) && isValidUnscheduledJob(incoming()) && incoming().id == existing().id && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['clientName', 'phone', 'address', 'serviceType', 'priority', 'estimatedHours', 'updatedAt'])
      );
      allow delete: if isAdmin() && isValidId(jobId);
    }

    // Staff Roster Collection
    match /staff/{staffId} {
      allow get: if isVerified() && isValidId(staffId);
      allow list: if isVerified();
      allow create: if isAdmin() && isValidId(staffId) && isValidStaff(incoming()) && incoming().id == staffId;
      allow update: if isAdmin() && isValidId(staffId) && isValidStaff(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(staffId);
    }

    // Van & Hub Overrides Collection
    match /vanOverrides/{vanId} {
      allow get: if isVerified() && isValidId(vanId);
      allow list: if isVerified();
      allow create: if isVerified() && isValidId(vanId) && isValidVanOverride(incoming()) && incoming().vanId == vanId;
      allow update: if isVerified() && isValidId(vanId) && isValidVanOverride(incoming()) && incoming().vanId == existing().vanId && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['customVanName', 'cleanerName', 'phone', 'hubId', 'customHubName', 'color', 'updatedAt'])
      );
      allow delete: if isAdmin() && isValidId(vanId);
    }

    // Quotes Collection
    match /quotes/{quoteId} {
      allow get: if isVerified() && isValidId(quoteId);
      allow list: if isVerified();
      allow create: if isVerified() && isValidId(quoteId) && isValidQuote(incoming()) && incoming().id == quoteId;
      allow update: if isVerified() && isValidId(quoteId) && isValidQuote(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(quoteId);
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow get: if isVerified() && isValidId(invoiceId);
      allow list: if isVerified();
      allow create: if isVerified() && isValidId(invoiceId) && isValidInvoice(incoming()) && incoming().id == invoiceId;
      allow update: if isVerified() && isValidId(invoiceId) && isValidInvoice(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(invoiceId);
    }

    // Service Catalog & Price List Collection (Publicly readable for live website booking & quotes; writable by verified staff/admin)
    function isValidServiceCatalogItem(data) {
      return data.keys().hasAll(['id', 'name', 'cleanersCount', 'quantity', 'unitPrice', 'total']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.cleanersCount is number && data.cleanersCount >= 1 && data.cleanersCount <= 20 &&
             data.quantity is number && data.quantity >= 0 && data.quantity <= 500 &&
             data.unitPrice is number && data.unitPrice >= -5000 && data.unitPrice <= 50000 &&
             data.total is number && data.total >= -5000 && data.total <= 100000;
    }

    match /serviceCatalog/{itemId} {
      allow get, list: if true;
      allow create, update: if isVerified() && isValidId(itemId) && isValidServiceCatalogItem(incoming()) && incoming().id == itemId;
      allow delete: if isVerified() && isValidId(itemId);
    }

    // Blocked Numbers & Spam Shield Rules Collection
    function isValidBlockedNumberRule(data) {
      return data.keys().hasAll(['id', 'pattern', 'ruleType', 'isActive', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'pattern', 'ruleType', 'reason', 'callerName', 'isActive', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.pattern is string && data.pattern.size() > 0 && data.pattern.size() <= 60 &&
             data.ruleType in ['number', 'prefix', 'areacode', 'country'] &&
             data.isActive is bool &&
             data.updatedAt is string && data.updatedAt.size() <= 60 &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 300)) &&
             (!('callerName' in data) || (data.callerName is string && data.callerName.size() <= 150)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    match /blockedNumbers/{blockId} {
      allow get, list: if isVerified();
      allow create, update: if isVerified() && isValidId(blockId) && isValidBlockedNumberRule(incoming()) && incoming().id == blockId;
      allow delete: if isVerified() && isValidId(blockId);
    }

    // Screened Calls & Blocked Call History Collection
    function isValidScreenedCallRecord(data) {
      return data.keys().hasAll(['id', 'callerNumber', 'status', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'callerNumber', 'callerName', 'status', 'isBlocked', 'manuallyBlocked', 'reason', 'aiSummary', 'transcript', 'serviceType', 'address', 'quotedAmount', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.callerNumber is string && data.callerNumber.size() > 0 && data.callerNumber.size() <= 40 &&
             data.status in ['SCREENED_LEAD', 'SOLICITOR_BLOCKED', 'MISSED_VOICEMAIL', 'BLOCKED'] &&
             data.updatedAt is string && data.updatedAt.size() <= 60 &&
             (!('callerName' in data) || (data.callerName is string && data.callerName.size() <= 150)) &&
             (!('isBlocked' in data) || data.isBlocked is bool) &&
             (!('manuallyBlocked' in data) || data.manuallyBlocked is bool) &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 500)) &&
             (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 1500)) &&
             (!('transcript' in data) || (data.transcript is string && data.transcript.size() <= 3000)) &&
             (!('serviceType' in data) || (data.serviceType is string && data.serviceType.size() <= 150)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
             (!('quotedAmount' in data) || (data.quotedAmount is number && data.quotedAmount >= 0 && data.quotedAmount <= 100000)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    match /screenedCalls/{callId} {
      allow get, list: if isVerified();
      allow create, update: if isVerified() && isValidId(callId) && isValidScreenedCallRecord(incoming()) && incoming().id == callId;
      allow delete: if isVerified() && isValidId(callId);
    }

    // Master Leads & Quotes Hub Collection
    function isValidLeadRecord(data) {
      return data.keys().hasAll(['id', 'customerName', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'customerName', 'phone', 'email', 'address', 'city', 'postalCode', 'serviceRequested', 'bedrooms', 'bathrooms', 'source', 'sourceTab', 'verdict', 'status', 'quoteId', 'quoteNumber', 'quotedAmount', 'notes', 'dateReceived', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150 &&
             data.updatedAt is string && data.updatedAt.size() <= 60 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('postalCode' in data) || (data.postalCode is string && data.postalCode.size() <= 30)) &&
             (!('serviceRequested' in data) || (data.serviceRequested is string && data.serviceRequested.size() <= 200)) &&
             (!('bedrooms' in data) || (data.bedrooms is string && data.bedrooms.size() <= 60)) &&
             (!('bathrooms' in data) || (data.bathrooms is string && data.bathrooms.size() <= 60)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 100)) &&
             (!('sourceTab' in data) || (data.sourceTab is string && data.sourceTab.size() <= 100)) &&
             (!('verdict' in data) || (data.verdict is string && data.verdict.size() <= 50)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('quoteId' in data) || (data.quoteId is string && data.quoteId.size() <= 128)) &&
             (!('quoteNumber' in data) || (data.quoteNumber is string && data.quoteNumber.size() <= 50)) &&
             (!('quotedAmount' in data) || (data.quotedAmount is number && data.quotedAmount >= 0 && data.quotedAmount <= 100000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2500)) &&
             (!('dateReceived' in data) || (data.dateReceived is string && data.dateReceived.size() <= 60));
    }

    match /leads/{leadId} {
      allow get, list: if isVerified();
      allow create, update: if isVerified() && isValidId(leadId) && isValidLeadRecord(incoming()) && incoming().id == leadId;
      allow delete: if isVerified() && isValidId(leadId);
    }

    // Persistent Workspace State Collection (Resume Where You Left Off)
    function isValidWorkspaceState(data) {
      return data.keys().hasAll(['id', 'activeTopView', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'activeTopView', 'masterHubFocusBlock', 'scheduledJobsSubTab', 'mapInspectDate', 'lastSyncedAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.activeTopView is string && data.activeTopView.size() > 0 && data.activeTopView.size() <= 60 &&
             data.updatedAt is string && data.updatedAt.size() <= 60 &&
             (!('masterHubFocusBlock' in data) || (data.masterHubFocusBlock is string && data.masterHubFocusBlock.size() <= 60)) &&
             (!('scheduledJobsSubTab' in data) || (data.scheduledJobsSubTab is string && data.scheduledJobsSubTab.size() <= 60)) &&
             (!('mapInspectDate' in data) || (data.mapInspectDate is string && data.mapInspectDate.size() <= 40)) &&
             (!('lastSyncedAt' in data) || (data.lastSyncedAt is string && data.lastSyncedAt.size() <= 60));
    }

    match /workspaceState/{stateId} {
      allow get, list: if isVerified();
      allow create, update: if isVerified() && isValidId(stateId) && isValidWorkspaceState(incoming()) && incoming().id == stateId;
      allow delete: if isAdmin() && isValidId(stateId);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isAdmin() && isValidId(adminId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(adminId);
      allow update: if isAdmin() && isValidId(adminId);
      allow delete: if isAdmin() && isValidId(adminId);
    }
  }
}
